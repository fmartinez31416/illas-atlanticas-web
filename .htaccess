<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 1. URLs antiguas que ya tienen posiciones en Google -> consolidar en la portada ---
  RewriteRule ^ubicacion/?$ / [R=301,L]
  RewriteRule ^ubicacion/(gastronomia|parque-nacional|cultura|excursiones)$ / [R=301,L]
  RewriteRule ^(blog|experiencias|contacto|preguntas-frecuentes|cookies|gastronomia|faq)$ / [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]

  # /en /es /gl no son páginas reales (la web traduce en el cliente) -> consolidar
  RewriteRule ^(en|es|gl)/?$ / [R=301,L]

  # --- 2. Ficheros reales (assets, fotos, favicon, ical, llms.txt...) se sirven tal cual ---
  # (los directorios NO pasan: /puente es directorio real y debe servir la SPA, no el índice)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # --- 3. Rutas de la SPA ---
  RewriteRule ^(puente|lonja|legal|planificador)/?$ /index.html [L]
  RewriteRule ^bitacora(/.*)?$ /index.html [L]
  RewriteRule ^$ /index.html [L]

  # --- 4. Cualquier otra cosa no existe: 404 real (sin páginas fantasma para Google) ---
  RewriteRule ^ - [R=404,L]
</IfModule>

# Tipos MIME para descubrimiento agéntico
<Files "llms.txt">
  ForceType text/markdown
</Files>
<Files "ai-catalog.json">
  ForceType application/ai-catalog+json
</Files>

# --- Rendimiento: caché de navegador (los assets llevan hash -> inmutables) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
