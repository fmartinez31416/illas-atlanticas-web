<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # URLs antiguas que ya tienen posiciones en Google -> consolidar en la portada
  RewriteRule ^ubicacion/?$ / [R=301,L]
  RewriteRule ^ubicacion/(gastronomia|parque-nacional|cultura|excursiones)$ / [R=301,L]
  RewriteRule ^(blog|experiencias|contacto|preguntas-frecuentes|cookies)$ / [R=301,L]

  # Rutas de servicio: servir la SPA directamente (evita el 301 de LiteSpeed por el directorio /puente)
  RewriteRule ^(puente|lonja|legal|planificador)/?$ /index.html [L]
  RewriteRule ^bitacora(/.*)?$ /index.html [L]

  # SPA: cualquier otra ruta sin archivo real sirve la app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Rendimiento: caché de navegador (los assets llevan hash -> inmutables) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
