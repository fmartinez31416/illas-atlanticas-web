AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www -> sin www (consolidar; solo actúa cuando el certificado cubre www)
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://illasatlanticasatico.es%{REQUEST_URI} [R=301,L]

  # --- 1. URLs antiguas que ya tienen posiciones en Google -> cada una a su equivalente nuevo ---
  # (datos Search Console 3m: /ubicacion/gastronomia 60 clics · /ubicacion 27 · parque-nacional 3 · preguntas-frecuentes 2 · contacto 1)
  RewriteRule ^ubicacion/gastronomia/?$ /gastronomia [R=301,L]
  RewriteRule ^ubicacion/parque-nacional/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  RewriteRule ^ubicacion/cultura/?$ /bitacora [R=301,L]
  RewriteRule ^ubicacion/excursiones/?$ /planificador [R=301,L]
  RewriteRule ^ubicacion/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  RewriteRule ^blog/?$ /bitacora [R=301,L]
  RewriteRule ^experiencias/?$ /planificador [R=301,L]
  RewriteRule ^preguntas-frecuentes/?$ /condiciones [R=301,L]
  RewriteRule ^cookies/?$ /legal [R=301,L]
  RewriteRule ^(contacto|faq)/?$ / [R=301,L]
  RewriteRule ^apartamento/?$ / [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]

  # Idiomas reales para hreflang: /en/ y /gl/ sirven la SPA (la ruta fija el idioma).
  # El español vive en la portada /: /es/ se consolida en / para no duplicar contenido.
  RewriteRule ^(en|gl)/?$ /index.html [L]
  RewriteRule ^(en|gl)/(puente|lonja|legal|condiciones|planificador|gastronomia|musica)/?$ /index.html [L]
  RewriteRule ^(en|gl)/gastronomia/metodologia/?$ /index.html [L]
  RewriteRule ^(en|gl)/bitacora(/.*)?$ /index.html [L]
  RewriteRule ^es/?$ / [R=301,L]

  # --- 2. Ficheros reales (assets, fotos, favicon, ical, llms.txt...) se sirven tal cual ---
  # (los directorios NO pasan: /puente es directorio real y debe servir la SPA, no el índice)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # --- 3. Rutas de la SPA ---
  RewriteRule ^(puente|lonja|legal|condiciones|planificador|gastronomia|musica|club)/?$ /index.html [L]
  RewriteRule ^gastronomia/metodologia/?$ /index.html [L]
  RewriteRule ^bitacora(/.*)?$ /index.html [L]
  RewriteRule ^$ /index.html [L]

  # --- 4. Cualquier otra cosa no existe: 404 real (sin páginas fantasma para Google) ---
  RewriteRule ^ - [R=404,L]
</IfModule>

# Tipos MIME para descubrimiento agéntico
<Files "llms.txt">
  ForceType text/markdown
</Files>
<Files "ai-catalog.json">
  ForceType application/ai-catalog+json
</Files>

# --- Rendimiento: caché de navegador (los assets llevan hash -> inmutables) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
