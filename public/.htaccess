AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www -> sin www (consolidar; solo actúa cuando el certificado cubre www)
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://illasatlanticasatico.es%{REQUEST_URI} [R=301,L]

  # --- 1. URLs antiguas que ya tienen posiciones en Google -> cada una a su equivalente nuevo ---
  # (datos Search Console 3m: /ubicacion/gastronomia 60 clics · /ubicacion 27 · parque-nacional 3 · preguntas-frecuentes 2 · contacto 1)
  RewriteRule ^ubicacion/gastronomia/?$ /gastronomia [R=301,L]
  RewriteRule ^ubicacion/parque-nacional/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  RewriteRule ^ubicacion/cultura/?$ /bitacora [R=301,L]
  RewriteRule ^ubicacion/excursiones/?$ /planificador [R=301,L]
  RewriteRule ^ubicacion/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  RewriteRule ^blog/?$ /bitacora [R=301,L]
  RewriteRule ^experiencias/?$ /planificador [R=301,L]
  RewriteRule ^preguntas-frecuentes/?$ /condiciones [R=301,L]
  RewriteRule ^cookies/?$ /legal [R=301,L]
  RewriteRule ^(contacto|faq)/?$ / [R=301,L]
  RewriteRule ^apartamento/?$ / [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]

  # Artículos del blog antiguo (Semrush 23-oct: seguían en el índice; sin redirect se perdía su equity)
  RewriteRule ^blog/como-visitar-isla-salvora-guia/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  RewriteRule ^blog/72-horas-gastronomia-ria-arousa/?$ /gastronomia [R=301,L]
  RewriteRule ^blog/festa-percebe-aguino-guia/?$ /bitacora/percebe-bravura-rompiente-aguiño-tabla-salmuera [R=301,L]
  RewriteRule ^blog/guia-completa-playas-ribeira/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  RewriteRule ^blog/guia-parque-natural-corrubedo/?$ /bitacora/faros-boca-ria-salvora-corrubedo-ons [R=301,L]
  RewriteRule ^blog/mejores-miradores-barbanza/?$ /bitacora/la-ilusion-de-la-linea-recta-cartografia-aguiño-salvora [R=301,L]
  RewriteRule ^blog/ruta-albarino-desde-aguino/?$ /gastronomia [R=301,L]
  RewriteRule ^blog/tour-castros-barbanza/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  RewriteRule ^ubicacion/naturaleza/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  RewriteRule ^ubicacion/playas/?$ /bitacora/guia-aguino-parque-nacional-illas-atlanticas [R=301,L]
  # (cuando se publique Cíes vs Sálvora: repuntar como-visitar-isla-salvora-guia a su slug)

  # Idiomas: /es/ se consolida en / (301). /en/ y /gl/ tienen sus propias páginas
  # prerenderizadas (title/canonical/hreflang propios por ruta e idioma).
  RewriteRule ^es/?$ / [R=301,L]
  RewriteRule ^es/(.+?)/?$ /$1 [R=301,L]

  # --- 2. Ficheros reales (assets, fotos, favicon, ical, llms.txt...) se sirven tal cual ---
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # --- 3. Rutas prerenderizadas: /X[/] -> /paginas/X/index.html si ese HTML existe ---
  # (portada, vistas, /en/ /gl/, metodología y artículos de la bitácora;
  #  sin redirects añadidos: la URL pública coincide con el canonical)
  RewriteCond %{DOCUMENT_ROOT}/paginas/$1/index.html -f
  RewriteRule ^(.+?)/?$ /paginas/$1/index.html [L]

  # --- 4. Portada ---
  RewriteRule ^$ /index.html [L]

  # --- 5. Cualquier otra cosa no existe: 404 real (sin páginas fantasma para Google) ---
  RewriteRule ^ - [R=404,L]
</IfModule>

# Tipos MIME para descubrimiento agéntico
<Files "llms.txt">
  ForceType text/markdown
</Files>
<Files "ai-catalog.json">
  ForceType application/ai-catalog+json
</Files>

# --- Rendimiento: caché de navegador (los assets llevan hash -> inmutables) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
